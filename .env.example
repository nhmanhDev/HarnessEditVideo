# Sao chép thành .env rồi điền. File .env không được commit.

# Claude API: lập kế hoạch dựng. Lấy ở console.anthropic.com.
ANTHROPIC_API_KEY=
# Mô hình lập kế hoạch. Đổi khi cần so sánh chất lượng.
EDIT_MODEL=claude-sonnet-5-5

# Giọng đọc (TTS). Bản đầu hỗ trợ openai.
TTS_PROVIDER=openai
OPENAI_API_KEY=
TTS_VOICE=alloy

# Nhận dạng giọng nói trên máy. Chạy bằng faster-whisper: tiny, base, small, medium.
WHISPER_MODEL=small

# Công cụ ffmpeg. Để trống nếu đã có trong PATH.
FFMPEG_BIN=
FFPROBE_BIN=

# Font có dấu tiếng Việt cho chữ và phụ đề. Để trống thì tự tìm trong thư mục font của hệ điều hành.
FONT_FILE=

# Thư mục làm việc (video, khung hình, kết quả). Để trống thì dùng workspace/ trong repo.
EDIT_WORKSPACE=
